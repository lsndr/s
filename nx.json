{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "typescript": ["{workspaceRoot}/tsconfig.base*.json"],
    "eslint": ["{workspaceRoot}/eslint.config.mjs", "typescript"],
    "vitest": ["{workspaceRoot}/vitest.shared.ts", "typescript"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "inputs": ["default", "^default", "typescript"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["default", "^default", "vitest"]
    },
    "test:build": {
      "cache": true,
      "inputs": ["default", "^default", "vitest"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default", "eslint"]
    }
  },
  "release": {
    "projects": ["packages/*"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": true,
      "specifierSource": "conventional-commits",
      "adjustSemverBumpsForZeroMajorVersion": true
    },
    "changelog": {
      "projectChangelogs": {
        "renderOptions": {
          "authors": false
        },
        "createRelease": "github",
        "file": false
      }
    },
    "conventionalCommits": {
      "types": {
        "feat": {
          "changelog": {
            "title": "Features"
          }
        },
        "fix": {
          "changelog": {
            "title": "Fixes"
          }
        },
        "perf": {
          "semverBump": "patch",
          "changelog": {
            "title": "Performance"
          }
        },
        "refactor": {
          "semverBump": "patch",
          "changelog": {
            "title": "Refactors"
          }
        },
        "docs": {
          "semverBump": "patch",
          "changelog": {
            "title": "Documentation"
          }
        },
        "build": {
          "semverBump": "patch",
          "changelog": {
            "title": "Build"
          }
        },
        "types": {
          "changelog": {
            "title": "Types"
          }
        },
        "chore": {
          "changelog": {
            "title": "Chore"
          }
        },
        "examples": {
          "changelog": {
            "title": "Examples"
          }
        },
        "test": {
          "changelog": {
            "title": "Tests"
          }
        },
        "style": {
          "changelog": {
            "title": "Styles"
          }
        },
        "ci": {
          "changelog": {
            "title": "CI"
          }
        },
        "revert": {
          "semverBump": "patch",
          "changelog": {
            "title": "Revert"
          }
        }
      }
    },
    "git": {
      "commitMessage": "chore(release): publish [skip ci]"
    }
  },
  "analytics": false
}
