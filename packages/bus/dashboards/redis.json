        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (messaging_destination_name, messaging_consumer_group_name) (redis_stream_lag{job=~\"$job\"})",
          "legendFormat": "{{messaging_consumer_group_name}} {{messaging_destination_name}}"
        }
