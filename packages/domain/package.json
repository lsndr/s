{
  "name": "@lsndr/domain",
  "version": "0.2.14",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint/no-state-recovery-constructor-usage": "./eslint/no-state-recovery-constructor-usage.mjs"
  },
  "files": [
    "dist",
    "eslint"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepack": "readme-links pin",
    "postpack": "readme-links restore"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lsndr/readme-links": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsndr/s.git",
    "directory": "packages/domain"
  }
}
