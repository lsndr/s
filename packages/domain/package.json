{
  "name": "@lsndrs/domain",
  "version": "0.2.20",
  "description": "Building blocks for DDD-style domain models: aggregate roots, value objects and domain errors, plus an ESLint rule.",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "aggregate-root",
    "value-object",
    "domain-events",
    "eslint-rule"
  ],
  "homepage": "https://github.com/lsndr/s/tree/main/packages/domain#readme",
  "bugs": {
    "url": "https://github.com/lsndr/s/issues"
  },
  "author": "lsndr",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eslint/no-state-recovery-constructor-usage": "./eslint/no-state-recovery-constructor-usage.mjs"
  },
  "files": [
    "dist",
    "eslint"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsndr/s.git",
    "directory": "packages/domain"
  }
}
