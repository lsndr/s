{
  "name": "@lsndrs/logger",
  "version": "0.2.0",
  "description": "A pino-based NestJS LoggerService that attaches request-scoped fields to every log entry written inside a context.",
  "keywords": [
    "nestjs",
    "logger",
    "pino",
    "logging",
    "structured-logging"
  ],
  "homepage": "https://github.com/lsndr/s/tree/main/packages/logger#readme",
  "bugs": {
    "url": "https://github.com/lsndr/s/issues"
  },
  "author": "lsndr",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:build": "tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "dependencies": {
    "pino": "^10.4.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "pino-pretty": "^13.0.0"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.6.0",
    "pino-pretty": "^13.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsndr/s.git",
    "directory": "packages/logger"
  }
}
